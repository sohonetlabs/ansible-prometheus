all:
  hosts:
    debian-10:
      prometheus_components:
        - node_exporter
        - prometheus
        - statsd_exporter
    localhost:
      ansible_connection: local
      ansible_python_interpreter: "{{ ansible_playbook_python }}"
    test:
      prometheus_additional_exporters:
       - name: docker
         port: 9323
         labels:
           my_environment: development
      prometheus_components:
        - node_exporter
  vars:
    prometheus_servers:
      - debian-10
